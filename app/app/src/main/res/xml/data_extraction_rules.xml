<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-to-device transfer rules.

  Only user.db is included (README Part 6, backup and migration): it is a few hundred
  KB, well inside the 25 MB quota. Everything else the app stores, namely the read-only
  release.db and the content media, comes back with the APK, so nothing else is listed.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="user.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user.db" />
    </device-transfer>
</data-extraction-rules>
