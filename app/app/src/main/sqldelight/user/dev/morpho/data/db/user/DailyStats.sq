-- Mirrors docs/contracts/user-db.sql :: daily_stats
--
-- Exact counts, never a rate: two sessions on the same day merge by adding, so no
-- rounding error accumulates and the day's accuracy is always recomputable.
CREATE TABLE daily_stats (
    date          TEXT PRIMARY KEY,
    new_learned   INTEGER NOT NULL DEFAULT 0,
    reviewed      INTEGER NOT NULL DEFAULT 0,
    correct_count INTEGER NOT NULL DEFAULT 0,
    answer_count  INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM daily_stats ORDER BY date DESC;

selectByDate:
SELECT * FROM daily_stats WHERE date = ?;

selectRecent:
SELECT * FROM daily_stats ORDER BY date DESC LIMIT ?;

upsert:
INSERT OR REPLACE INTO daily_stats (date, new_learned, reviewed, correct_count, answer_count)
VALUES (?, ?, ?, ?, ?);

deleteAll:
DELETE FROM daily_stats;
