# Dev defaults: fully mocked, no morphod required.
# Set VITE_API_MOCK=0 (e.g. in .env.development.local) to proxy /api to a live morphod.
VITE_API_MOCK=1
VITE_MORPHOD_URL=http://127.0.0.1:8787
# Sent as X-Morpho-User on every mutation; morphod defaults to `local` without it.
VITE_MORPHO_USER=local
